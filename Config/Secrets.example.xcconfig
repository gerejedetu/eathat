// Copy to Config/Secrets.xcconfig (gitignored) and fill in.

// Your Apple team and a bundle id prefix you own (reverse DNS).
DEVELOPMENT_TEAM =
EATHAT_BUNDLE_ID_PREFIX = com.example

// Your Worker (`npm run deploy` in api/ prints it). `$()` keeps the `//` from starting a comment.
EATHAT_API_URL = https:/$()/eathat-api.YOUR-SUBDOMAIN.workers.dev
// The same value as the Worker secret EATHAT_API_KEY.
EATHAT_API_KEY =
